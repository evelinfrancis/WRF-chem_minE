# See options.txt for a (somewhat up to date) list of the 
# options that may be specified here.
===============================
# Add following lines to the GEOGRID.TBL to introduce EMIT, J2014 & C1999 to WPS
===============================

name=EMIT_CALCITE
        priority=1
        dest_type=continuous
        interp_option=default:average_gcell(0.0)+average_4pt+nearest_neighbor
        smooth_option=0
        rel_path=emit_calcite
        missing_value = 0
        fill_missing = 0
        
===============================

